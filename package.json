{
  "name": "qps-shop",
  "private": false,
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "start": "turbo start",
    "lint": "turbo lint",
    "test": "turbo test",
    "backend:seed": "turbo seed --filter=@dtc/backend",
    "backend:dev": "turbo dev --filter=@dtc/backend",
    "storefront:dev": "turbo dev --filter=@dtc/storefront",

    "backend:build": "pnpm --filter @dtc/backend build",
    "backend:start": "pnpm --filter @dtc/backend start",
    "backend:deploy": "pnpm --filter @dtc/backend exec medusa db:migrate && pnpm --filter @dtc/backend start",
    "backend:railway": "pnpm backend:build && pnpm --filter @dtc/backend exec medusa db:migrate && pnpm --filter @dtc/backend start",

    "storefront:build": "pnpm --filter @dtc/storefront build",
    "storefront:start": "pnpm --filter @dtc/storefront start"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.5",
      "@types/react-dom": "19.0.5"
    },
    "onlyBuiltDependencies": [
      "@medusajs/telemetry",
      "@swc/core",
      "esbuild",
      "msgpackr-extract",
      "protobufjs",
      "sharp",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "turbo": "^2.0.14",
    "prettier": "^3.2.5"
  }
}
