# Medusa Backend URL (Produktion)
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.shop.qpsag.com

# Publishable API Key – aus dem Medusa Admin unter Settings > API Keys
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_...

# Standard-Region (ch = Schweiz, de = Deutschland, etc.)
NEXT_PUBLIC_DEFAULT_REGION=ch

# Storefront-URL
NEXT_PUBLIC_BASE_URL=https://shop.qpsag.com

# Stripe publishable key (öffentlich – kein Secret!)
NEXT_PUBLIC_STRIPE_KEY=pk_live_...

NODE_ENV=production
