MEDUSA_ADMIN_ONBOARDING_TYPE=nextjs
MEDUSA_ADMIN_ONBOARDING_NEXTJS_DIRECTORY=../storefront

# CORS – Produktions-URLs eintragen (Railway/Vercel)
STORE_CORS=https://shop.qpsag.com
ADMIN_CORS=https://admin.shop.qpsag.com
AUTH_CORS=https://shop.qpsag.com,https://admin.shop.qpsag.com

# Secrets – starke Zufallswerte generieren: node -e "require('crypto').randomBytes(32).toString('hex')"
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
COOKIE_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET

# Datenbank (PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB_NAME

# Redis (empfohlen für Produktion)
REDIS_URL=redis://USER:PASSWORD@HOST:PORT

# Stripe
STRIPE_API_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
